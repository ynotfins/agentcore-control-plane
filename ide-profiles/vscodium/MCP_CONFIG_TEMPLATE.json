{
  "mcpServers": {
    "agentcore-gateway": {
      "type": "streamable-http",
      "url": "http://127.0.0.1:8080/mcp",
      "headers": {
        "Authorization": "Bearer ${env:BIFROST_MCP_VIRTUAL_KEY}"
      }
    }
  },
  "_agentcore": {
    "renderer": "vscodium",
    "source_contract": "contracts/agentcore-gateway-client.json",
    "gateway_enrollment_status": "env_header",
    "active_template": true,
    "secret_policy": "Never paste or persist an AgentCore virtual key; env references only."
  }
}