{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentcore.local/contracts/schemas/bifrost-upstream-mcp-registry.schema.json",
  "title": "AgentCore Bifrost Upstream MCP Registry",
  "description": "Canonical upstream MCP server registry for the AgentCore Bifrost MCP Gateway. Secret values must never appear; use Windows environment variable names only.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "gateway_id",
    "authority",
    "runtime_root",
    "swarm_exclusion",
    "capability_profiles",
    "servers"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "minLength": 1
    },
    "gateway_id": {
      "type": "string",
      "const": "agentcore-gateway"
    },
    "authority": {
      "type": "string",
      "description": "Canonical Git authority path for this registry."
    },
    "runtime_root": {
      "type": "string",
      "description": "Bifrost runtime root on the operator host."
    },
    "swarm_exclusion": {
      "type": "array",
      "description": "Canonical IDs and path markers that must never be registered, wrapped, started, or depended on by the Bifrost gateway.",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "tool_lifecycle_note": {
      "type": "string",
      "description": "Transitional tool-exposure classification note (see contracts/project-tool-lifecycle.json). Informational only; not rendered into the Bifrost runtime config."
    },
    "output_schema_adapter": {
      "type": "object",
      "description": "Wiring for the MCP outputSchema / structuredContent normalizer that render_bifrost_config.py injects in front of each stdio upstream. Adds no MCP route and no tool; per-server applicability is declared in the contract referenced by `contract`.",
      "additionalProperties": false,
      "required": ["enabled", "interpreter", "script", "contract"],
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Master switch. false renders upstream stdio launches unwrapped (rollback posture; outputSchema disappears and the validator reports MissingOutputSchema)."
        },
        "interpreter": {
          "type": "string",
          "minLength": 1,
          "description": "Absolute path to the Python interpreter that runs the normalizer. Never a secret."
        },
        "script": {
          "type": "string",
          "minLength": 1,
          "description": "Authority-relative path to the normalizer entrypoint."
        },
        "contract": {
          "type": "string",
          "minLength": 1,
          "description": "Authority-relative path to contracts/mcp-tool-output-schemas.json."
        },
        "notes": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "capability_profiles": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/capability_profile"
      }
    },
    "servers": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z0-9][a-z0-9_-]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/upstream_server"
      }
    }
  },
  "$defs": {
    "capability_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "display_name",
        "purpose",
        "allowed_server_ids",
        "default_tools_policy"
      ],
      "properties": {
        "display_name": { "type": "string", "minLength": 1 },
        "purpose": { "type": "string", "minLength": 1 },
        "allowed_server_ids": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "default_tools_policy": {
          "type": "string",
          "enum": ["allow_permitted", "deny_by_default", "profile_override"]
        },
        "notes": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "retry_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_attempts", "backoff_seconds"],
      "properties": {
        "max_attempts": { "type": "integer", "minimum": 0, "maximum": 10 },
        "backoff_seconds": { "type": "number", "minimum": 0 },
        "retry_on": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "logging_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["log_invocations", "log_content", "redact_secrets"],
      "properties": {
        "log_invocations": { "type": "boolean" },
        "log_content": { "type": "boolean" },
        "redact_secrets": { "type": "boolean" }
      }
    },
    "admission_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact",
        "source",
        "license",
        "tool_inventory",
        "authentication",
        "storage",
        "code_mode",
        "protected_resources",
        "default_disposition",
        "canary",
        "database_allowlist",
        "evidence_sources",
        "unresolved_gaps"
      ],
      "properties": {
        "artifact": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "identifier", "version", "digest"],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "npm_package",
                "python_package",
                "container_image",
                "remote_endpoint",
                "repo_owned",
                "local_wrapper",
                "unresolved"
              ]
            },
            "identifier": { "type": "string", "minLength": 1 },
            "version": { "type": "string", "minLength": 1 },
            "digest": {
              "type": ["string", "null"],
              "pattern": "^sha256:[a-f0-9]{64}$"
            }
          }
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["primary_url", "documentation_url", "verification"],
          "properties": {
            "primary_url": { "type": "string", "minLength": 1 },
            "documentation_url": { "type": "string", "minLength": 1 },
            "verification": {
              "type": "string",
              "enum": ["arabold_exact", "operator_verified", "registry_verified", "unresolved"]
            }
          }
        },
        "license": {
          "type": "object",
          "additionalProperties": false,
          "required": ["spdx", "status", "source_url"],
          "properties": {
            "spdx": { "type": "string", "minLength": 1 },
            "status": {
              "type": "string",
              "enum": ["verified", "unresolved", "not_applicable"]
            },
            "source_url": { "type": "string", "minLength": 1 }
          }
        },
        "tool_inventory": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "source", "tools", "reported_tool_count"],
          "properties": {
            "status": {
              "type": "string",
              "enum": ["verified", "partial", "reported_unverified", "unresolved", "not_applicable"]
            },
            "source": { "type": "string", "minLength": 1 },
            "tools": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "uniqueItems": true
            },
            "reported_tool_count": { "type": ["integer", "null"], "minimum": 0 }
          }
        },
        "authentication": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "status", "credential_storage", "env_var_names", "dsn_references"],
          "properties": {
            "mode": {
              "type": "string",
              "enum": ["none", "headers", "oauth", "per_user_oauth", "per_user_headers", "unresolved"]
            },
            "status": {
              "type": "string",
              "enum": ["verified", "pending_review", "unresolved", "not_required"]
            },
            "credential_storage": {
              "type": "string",
              "enum": ["none", "windows_user_env", "bifrost_oauth_store", "provider_managed", "unresolved"]
            },
            "env_var_names": {
              "type": "array",
              "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
              "uniqueItems": true
            },
            "dsn_references": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "uniqueItems": true
            }
          }
        },
        "storage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["classification", "status", "candidate_roots", "forbidden_roots"],
          "properties": {
            "classification": {
              "type": "string",
              "enum": [
                "none",
                "project_local",
                "agentcore_runtime",
                "remote_provider",
                "container_managed",
                "unrestricted_host",
                "unresolved"
              ]
            },
            "status": {
              "type": "string",
              "enum": ["verified", "pending_review", "unresolved", "not_applicable", "rejected"]
            },
            "candidate_roots": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "uniqueItems": true
            },
            "forbidden_roots": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "uniqueItems": true
            }
          }
        },
        "code_mode": {
          "type": "object",
          "additionalProperties": false,
          "required": ["decision", "rationale"],
          "properties": {
            "decision": {
              "type": "string",
              "enum": ["classic", "enabled", "required_if_admitted", "not_applicable", "rejected", "unresolved"]
            },
            "rationale": { "type": "string", "minLength": 1 }
          }
        },
        "protected_resources": {
          "type": "object",
          "additionalProperties": false,
          "required": ["classes", "default_access", "policy"],
          "properties": {
            "classes": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "uniqueItems": true
            },
            "default_access": {
              "type": "string",
              "enum": ["none", "read_only", "bounded_write", "jit", "operator_only", "rejected"]
            },
            "policy": { "type": "string", "minLength": 1 }
          }
        },
        "default_disposition": {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "replacement_route", "activation_requirements"],
          "properties": {
            "state": {
              "type": "string",
              "enum": ["active_profile", "dormant_zero_profile", "deferred_fail_closed", "catalogued_zero_profile", "rejected"]
            },
            "replacement_route": { "type": "string", "minLength": 1 },
            "activation_requirements": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "uniqueItems": true
            }
          }
        },
        "canary": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "probes"],
          "properties": {
            "status": {
              "type": "string",
              "enum": ["passed", "required_before_activation", "not_applicable", "rejected"]
            },
            "probes": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "uniqueItems": true
            }
          }
        },
        "database_allowlist": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "evidence_sources": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1,
          "uniqueItems": true
        },
        "unresolved_gaps": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    },
    "upstream_server": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonical_id",
        "display_name",
        "purpose",
        "owner",
        "pinned_version",
        "connection_type",
        "executable_or_url",
        "arguments",
        "env_var_names",
        "timeout_seconds",
        "health_check_type",
        "project_scope",
        "write_classification",
        "permitted_tools",
        "denied_tools",
        "capability_profiles",
        "logging_policy",
        "retry_policy",
        "rollback_route",
        "enabled",
        "bifrost_client_name"
      ],
      "properties": {
        "canonical_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]*$",
          "description": "Hyphenated AgentCore registry ID."
        },
        "display_name": { "type": "string", "minLength": 1 },
        "purpose": { "type": "string", "minLength": 1 },
        "owner": { "type": "string", "minLength": 1 },
        "pinned_version": { "type": "string", "minLength": 1 },
        "connection_type": {
          "type": "string",
          "enum": ["stdio", "http", "sse", "router"]
        },
        "executable_or_url": {
          "type": "string",
          "minLength": 1,
          "description": "Command path, npx package launcher, or URL/env reference. Never embed secret values."
        },
        "arguments": {
          "type": "array",
          "items": { "type": "string" }
        },
        "env_var_names": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]*$"
          },
          "uniqueItems": true
        },
        "env_aliases": {
          "type": "object",
          "description": "Child environment variable names mapped to reviewed parent environment variable names. Values remain names only; the stdio adapter resolves secret values at process launch.",
          "propertyNames": {
            "pattern": "^[A-Z][A-Z0-9_]*$"
          },
          "additionalProperties": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]*$"
          }
        },
        "timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 3600 },
        "health_check_type": {
          "type": "string",
          "enum": ["mcp_ping", "process", "http_get", "tcp", "none"]
        },
        "project_scope": {
          "type": "string",
          "enum": ["global", "project"]
        },
        "write_classification": {
          "type": "string",
          "enum": ["read_only", "bounded_write", "write_capable", "admin"]
        },
        "permitted_tools": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "denied_tools": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "capability_profiles": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 0,
          "uniqueItems": true,
          "description": "Profiles eligible for JIT lease grants. Empty array means dormant (no permanent tool exposure). Not added to capability_profiles[*].allowed_server_ids unless JIT lease is active."
        },
        "logging_policy": { "$ref": "#/$defs/logging_policy" },
        "retry_policy": { "$ref": "#/$defs/retry_policy" },
        "rollback_route": {
          "type": "string",
          "minLength": 1,
          "description": "Documented recovery path if this upstream must be disabled."
        },
        "enabled": { "type": "boolean" },
        "bifrost_client_name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "description": "Bifrost MCP client name. Underscores only; no hyphens or spaces."
        },
        "admission_evidence": {
          "$ref": "#/$defs/admission_evidence"
        },
        "is_code_mode_client": {
          "type": "boolean",
          "description": "When true, render this upstream as a Bifrost Code Mode MCP client. Use only for heavy global clients after exact tool inventory and rollback are documented."
        },
        "allowed_extra_headers": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Per-request headers forwarded to HTTP/SSE MCP servers."
        },
        "is_ping_available": {
          "type": "boolean",
          "description": "Whether Bifrost should issue MCP ping probes to this client."
        },
        "headers": {
          "type": "object",
          "additionalProperties": { "type": "string" },
          "description": "Static HTTP headers using env.VAR references only."
        },
        "auth_type": {
          "type": "string",
          "enum": ["none", "headers", "oauth", "per_user_oauth", "per_user_headers"]
        },
        "wrapper_script": {
          "type": "string",
          "description": "Relative path to project-router wrapper when connection_type is router."
        },
        "notes": {
          "type": "array",
          "items": { "type": "string" }
        },
        "deferred": { "type": "boolean" },
        "status": {
          "type": "string",
          "enum": [
            "active",
            "deferred",
            "disabled",
            "quarantine",
            "dormant",
            "dormant_project_scoped",
            "developer_preview_oauth_pending",
            "catalogued_unverified",
            "rejected"
          ],
          "description": "Lifecycle posture. dormant_project_scoped = registered but not default-exposed pending project lease. developer_preview_oauth_pending = registered remote MCP awaiting OAuth proof."
        },
        "oauth_config": {
          "type": "object",
          "description": "OAuth 2.0/2.1 config for upstream HTTP/SSE clients. Never include tokens, client_secret, access codes, or any secret values.",
          "additionalProperties": false,
          "properties": {
            "server_url":        { "type": "string", "description": "OAuth discovery root (used with .well-known endpoints and DCR)." },
            "client_id":        { "type": "string" },
            "authorize_url":    { "type": "string" },
            "token_url":        { "type": "string" },
            "registration_url": { "type": "string" },
            "scopes":           { "type": "array", "items": { "type": "string" } }
          }
        },
        "tool_groups": {
          "type": "object",
          "description": "Named tool groups consumed by the M6 capability lease system. Keys are group IDs referenced in capability_lease.tool_group_id.",
          "additionalProperties": {
            "type": "object",
            "required": ["tools", "access_policy"],
            "additionalProperties": false,
            "properties": {
              "tools": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 }
              },
              "access_policy": {
                "type": "string",
                "enum": ["default_profile", "jit_short", "operator_scope", "billable_approval"]
              },
              "description": { "type": "string" },
              "content_trust_class": {
                "type": "string",
                "enum": ["raw_untrusted", "promoted", "trusted"]
              },
              "upload_policy": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "forbid": {
                    "type": "array",
                    "items": { "type": "string", "minLength": 1 }
                  },
                  "trust_class_on_result": {
                    "type": "string",
                    "enum": ["raw_untrusted", "promoted", "trusted"]
                  }
                }
              },
              "lease_defaults": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "max_duration_seconds": { "type": "integer", "minimum": 1 },
                  "max_invocations":      { "type": "integer", "minimum": 1 },
                  "requires_approval":    { "type": "boolean" }
                }
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "connection_type": { "const": "router" } },
            "required": ["connection_type"]
          },
          "then": {
            "required": ["wrapper_script"]
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": ["catalogued_unverified", "rejected"]
              }
            },
            "required": ["status"]
          },
          "then": {
            "required": ["admission_evidence"],
            "properties": {
              "enabled": { "const": false },
              "capability_profiles": { "maxItems": 0 },
              "permitted_tools": { "maxItems": 0 }
            }
          }
        }
      ]
    }
  }
}
