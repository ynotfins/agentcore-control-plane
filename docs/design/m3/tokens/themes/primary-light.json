{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Theme 1 — M3 Primary Light. Multi-color: blue primary, red secondary, green tertiary + orange/pink/yellow accents.",
  "$extensions": { "agentcore.dataTheme": "primary-light", "agentcore.seedStatus": "TEMPORARY_PLACEHOLDER" },
  "md": {
    "sys": {
      "color": {
        "primary": { "$value": "{md.ref.palette.blue.40}", "$type": "color" },
        "onPrimary": { "$value": "{md.ref.palette.neutral.100}", "$type": "color" },
        "primaryContainer": { "$value": "{md.ref.palette.blue.90}", "$type": "color" },
        "onPrimaryContainer": { "$value": "{md.ref.palette.primary.10}", "$type": "color" },
        "secondary": { "$value": "{md.ref.palette.secondary.40}", "$type": "color" },
        "onSecondary": { "$value": "{md.ref.palette.neutral.100}", "$type": "color" },
        "secondaryContainer": { "$value": "{md.ref.palette.secondary.90}", "$type": "color" },
        "onSecondaryContainer": { "$value": "{md.ref.palette.secondary.10}", "$type": "color" },
        "tertiary": { "$value": "{md.ref.palette.green.40}", "$type": "color" },
        "onTertiary": { "$value": "{md.ref.palette.neutral.100}", "$type": "color" },
        "tertiaryContainer": { "$value": "{md.ref.palette.green.90}", "$type": "color" },
        "onTertiaryContainer": { "$value": "{md.ref.palette.tertiary.10}", "$type": "color" },
        "surface": { "$value": "{md.ref.palette.neutral.98}", "$type": "color" },
        "onSurface": { "$value": "{md.ref.palette.neutral.10}", "$type": "color" },
        "surfaceContainer": { "$value": "{md.ref.palette.neutral.94}", "$type": "color" },
        "surfaceContainerHigh": { "$value": "{md.ref.palette.neutral.92}", "$type": "color" },
        "surfaceContainerHighest": { "$value": "{md.ref.palette.neutral.90}", "$type": "color" },
        "outline": { "$value": "{md.ref.palette.neutralVariant.50}", "$type": "color" },
        "outlineVariant": { "$value": "{md.ref.palette.neutralVariant.80}", "$type": "color" }
      },
      "state": {
        "hover": {
          "surfaceTint": { "$value": "{md.ref.palette.blue.50}", "$type": "color" },
          "surfaceTintAmount": { "$value": "12%", "$type": "percentage" },
          "borderColor": { "$value": "{md.ref.palette.blue.40}", "$type": "color" },
          "saturate": { "$value": "1.12", "$type": "number" }
        }
      }
    },
    "custom": {
      "accent": {
        "orange": { "$value": "{md.ref.palette.orange.50}", "$type": "color" },
        "pink": { "$value": "{md.ref.palette.pink.50}", "$type": "color" },
        "yellow": { "$value": "{md.ref.palette.yellow.50}", "$type": "color" }
      },
      "icon": {
        "multicolorA": { "$value": "{md.ref.palette.blue.50}", "$type": "color" },
        "multicolorB": { "$value": "{md.ref.palette.green.50}", "$type": "color" },
        "multicolorC": { "$value": "{md.ref.palette.yellow.50}", "$type": "color" }
      },
      "stroke": { "featured": { "$value": "transparent", "$type": "color" } },
      "rainbowPulse": { "enabled": { "$value": false, "$type": "boolean" } }
    }
  }
}
