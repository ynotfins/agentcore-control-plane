{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Theme 2 — Secondary Light. Light orange primary, dark orange secondary, blue/green accents, yellow featured strokes.",
  "$extensions": { "agentcore.dataTheme": "secondary-light", "agentcore.seedStatus": "TEMPORARY_PLACEHOLDER" },
  "md": {
    "sys": {
      "color": {
        "primary": { "$value": "{md.ref.palette.orange.50}", "$type": "color" },
        "onPrimary": { "$value": "{md.ref.palette.neutral.10}", "$type": "color" },
        "primaryContainer": { "$value": "{md.ref.palette.orange.90}", "$type": "color" },
        "onPrimaryContainer": { "$value": "{md.ref.palette.orangeDark.30}", "$type": "color" },
        "secondary": { "$value": "{md.ref.palette.orangeDark.40}", "$type": "color" },
        "onSecondary": { "$value": "{md.ref.palette.neutral.100}", "$type": "color" },
        "secondaryContainer": { "$value": "{md.ref.palette.orange.95}", "$type": "color" },
        "onSecondaryContainer": { "$value": "{md.ref.palette.orangeDark.30}", "$type": "color" },
        "tertiary": { "$value": "{md.ref.palette.blue.40}", "$type": "color" },
        "onTertiary": { "$value": "{md.ref.palette.neutral.100}", "$type": "color" },
        "tertiaryContainer": { "$value": "{md.ref.palette.green.90}", "$type": "color" },
        "onTertiaryContainer": { "$value": "{md.ref.palette.green.40}", "$type": "color" },
        "surface": { "$value": "{md.ref.palette.orange.95}", "$type": "color" },
        "onSurface": { "$value": "{md.ref.palette.neutral.10}", "$type": "color" },
        "surfaceContainer": { "$value": "{md.ref.palette.neutral.98}", "$type": "color" },
        "surfaceContainerHigh": { "$value": "{md.ref.palette.neutral.96}", "$type": "color" },
        "surfaceContainerHighest": { "$value": "{md.ref.palette.neutral.94}", "$type": "color" },
        "outline": { "$value": "{md.ref.palette.orangeDark.40}", "$type": "color" },
        "outlineVariant": { "$value": "{md.ref.palette.orange.80}", "$type": "color" }
      }
    },
    "custom": {
      "accent": {
        "blue": { "$value": "{md.ref.palette.blue.50}", "$type": "color" },
        "green": { "$value": "{md.ref.palette.green.50}", "$type": "color" }
      },
      "stroke": { "featured": { "$value": "{md.ref.palette.yellow.50}", "$type": "color" } },
      "icon": {
        "multicolorA": { "$value": "{md.ref.palette.orange.50}", "$type": "color" },
        "multicolorB": { "$value": "{md.ref.palette.blue.50}", "$type": "color" },
        "multicolorC": { "$value": "{md.ref.palette.green.50}", "$type": "color" }
      },
      "rainbowPulse": { "enabled": { "$value": false, "$type": "boolean" } }
    }
  }
}
