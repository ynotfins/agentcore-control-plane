{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "md": {
    "ref": {
      "motion": {
        "duration": {
          "short": { "$value": "120ms", "$type": "duration" },
          "medium": { "$value": "280ms", "$type": "duration" },
          "long": { "$value": "450ms", "$type": "duration" },
          "extraLong": { "$value": "700ms", "$type": "duration" }
        },
        "easing": {
          "standard": { "$value": "cubic-bezier(0.2, 0, 0, 1)", "$type": "cubicBezier" },
          "emphasized": { "$value": "cubic-bezier(0.16, 1, 0.3, 1)", "$type": "cubicBezier" }
        },
        "custom": {
          "pulse": {
            "duration": { "$value": "4000ms", "$type": "duration", "$description": "md.custom.rainbowPulse loop" }
          }
        }
      }
    }
  }
}
