{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "md": {
    "ref": {
      "elevation": {
        "0": { "$value": "none", "$type": "shadow" },
        "1": { "$value": "0 1px 2px oklch(0% 0 0 / 0.06), 0 1px 3px oklch(0% 0 0 / 0.08)", "$type": "shadow" },
        "2": { "$value": "0 2px 6px oklch(0% 0 0 / 0.08), 0 4px 12px oklch(0% 0 0 / 0.10)", "$type": "shadow" },
        "3": { "$value": "0 4px 12px oklch(0% 0 0 / 0.10), 0 8px 24px oklch(0% 0 0 / 0.12)", "$type": "shadow" },
        "4": { "$value": "0 8px 20px oklch(0% 0 0 / 0.12), 0 16px 40px oklch(0% 0 0 / 0.16)", "$type": "shadow" },
        "5": { "$value": "0 12px 32px oklch(0% 0 0 / 0.16), 0 24px 60px oklch(0% 0 0 / 0.20)", "$type": "shadow" }
      }
    }
  }
}
