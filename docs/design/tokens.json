{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "AgentCore Design System — W3C Design Tokens source of truth. Compiled to CSS @theme (Tailwind v4). Three themes: light, dark, hc. Locked policy: docs/design/DESIGN_SYSTEM.md.",
  "color": {
    "surface": {
      "page":    { "$value": "oklch(99% 0.005 250)", "$type": "color", "$description": "Page background" },
      "card":    { "$value": "oklch(100% 0 0)",      "$type": "color", "$description": "Card surface" },
      "raised":  { "$value": "oklch(98% 0.005 250)", "$type": "color", "$description": "Elevated surface (inputs, buttons)" }
    },
    "ink": {
      "primary": { "$value": "oklch(20% 0.02 250)",  "$type": "color", "$description": "Body text" },
      "muted":   { "$value": "oklch(50% 0.02 250)",  "$type": "color", "$description": "Secondary text" },
      "inverse": { "$value": "oklch(98% 0 0)",       "$type": "color", "$description": "Text on dark surface" }
    },
    "brand": {
      "orange":  { "$value": "oklch(68% 0.22 35)",   "$type": "color", "$description": "Speakeasy primary accent" },
      "blue":    { "$value": "oklch(70% 0.15 230)",  "$type": "color", "$description": "Info / link" },
      "green":   { "$value": "oklch(72% 0.18 145)",  "$type": "color", "$description": "Success" },
      "pink":    { "$value": "oklch(70% 0.20 0)",    "$type": "color", "$description": "Destructive / record" }
    },
    "border": {
      "subtle":  { "$value": "oklch(0% 0 0 / 0.08)", "$type": "color", "$description": "Hairline borders" },
      "strong":  { "$value": "oklch(0% 0 0 / 0.16)", "$type": "color" }
    },
    "gradient": {
      "rainbow": { "$value": "linear-gradient(90deg, oklch(65% 0.25 25), oklch(75% 0.20 60), oklch(85% 0.20 95), oklch(72% 0.20 145), oklch(75% 0.15 230), oklch(60% 0.20 290), oklch(65% 0.25 0))", "$type": "gradient", "$description": "Static rainbow border (light theme)" },
      "tracer":  { "$value": "conic-gradient(from 0deg, transparent 65%, #00F0FF 90%, transparent 100%)", "$type": "gradient", "$description": "Rotating cyan tracer (dark theme)" }
    }
  },
  "radius": {
    "xs":   { "$value": "4px",    "$type": "dimension" },
    "sm":   { "$value": "8px",    "$type": "dimension" },
    "md":   { "$value": "12px",   "$type": "dimension" },
    "lg":   { "$value": "16px",   "$type": "dimension" },
    "xl":   { "$value": "20px",   "$type": "dimension" },
    "2xl":  { "$value": "24px",   "$type": "dimension" },
    "3xl":  { "$value": "32px",   "$type": "dimension" },
    "pill": { "$value": "9999px", "$type": "dimension" }
  },
  "space": {
    "0":  { "$value": "0",    "$type": "dimension" },
    "1":  { "$value": "4px",  "$type": "dimension" },
    "2":  { "$value": "8px",  "$type": "dimension" },
    "3":  { "$value": "12px", "$type": "dimension" },
    "4":  { "$value": "16px", "$type": "dimension" },
    "5":  { "$value": "20px", "$type": "dimension" },
    "6":  { "$value": "24px", "$type": "dimension" },
    "8":  { "$value": "32px", "$type": "dimension" },
    "10": { "$value": "40px", "$type": "dimension" },
    "12": { "$value": "48px", "$type": "dimension" },
    "16": { "$value": "64px", "$type": "dimension" },
    "24": { "$value": "96px", "$type": "dimension" }
  },
  "shadow": {
    "sm":   { "$value": "0 1px 2px oklch(0% 0 0 / 0.06)",  "$type": "shadow" },
    "md":   { "$value": "0 4px 12px oklch(0% 0 0 / 0.10)", "$type": "shadow" },
    "lg":   { "$value": "0 12px 32px oklch(0% 0 0 / 0.18)","$type": "shadow" },
    "xl":   { "$value": "0 24px 60px oklch(0% 0 0 / 0.28)","$type": "shadow" },
    "glow": { "$value": "0 0 24px oklch(68% 0.22 35 / 0.35)","$type": "shadow", "$description": "Brand orange glow" }
  },
  "duration": {
    "fast":    { "$value": "120ms",  "$type": "duration" },
    "default": { "$value": "280ms",  "$type": "duration" },
    "slow":    { "$value": "600ms",  "$type": "duration" },
    "tracer":  { "$value": "3500ms", "$type": "duration", "$description": "Rotating rainbow loop" }
  },
  "easing": {
    "smooth": { "$value": "cubic-bezier(0.16, 1, 0.3, 1)", "$type": "cubic-bezier" },
    "snap":   { "$value": "cubic-bezier(0.2, 0, 0, 1)",    "$type": "cubic-bezier" }
  },
  "$themes": {
    "light": {
      "color.surface.page":   { "$value": "oklch(99% 0.005 250)" },
      "color.surface.card":   { "$value": "oklch(100% 0 0)" },
      "color.surface.raised": { "$value": "oklch(98% 0.005 250)" },
      "color.ink.primary":    { "$value": "oklch(20% 0.02 250)" },
      "color.ink.muted":      { "$value": "oklch(50% 0.02 250)" },
      "color.ink.inverse":    { "$value": "oklch(98% 0 0)" }
    },
    "dark": {
      "color.surface.page":   { "$value": "oklch(8% 0 0)" },
      "color.surface.card":   { "$value": "oklch(11% 0 0)" },
      "color.surface.raised": { "$value": "oklch(14% 0 0)" },
      "color.ink.primary":    { "$value": "oklch(98% 0 0)" },
      "color.ink.muted":      { "$value": "oklch(65% 0.01 250)" },
      "color.ink.inverse":    { "$value": "oklch(15% 0 0)" },
      "color.brand.orange":   { "$value": "oklch(72% 0.20 35)" },
      "color.brand.blue":     { "$value": "oklch(75% 0.13 230)" },
      "color.brand.green":    { "$value": "oklch(75% 0.16 145)" },
      "color.brand.pink":     { "$value": "oklch(72% 0.20 0)" }
    },
    "hc": {
      "color.surface.page":   { "$value": "#000" },
      "color.surface.card":   { "$value": "#000" },
      "color.surface.raised": { "$value": "#000" },
      "color.ink.primary":    { "$value": "#fff" },
      "color.ink.muted":      { "$value": "#d0d0d0" },
      "color.brand.orange":   { "$value": "#ff8a4a", "$description": "Brighter for WCAG AAA" },
      "shadow.glow":          { "$value": "none" }
    }
  }
}
